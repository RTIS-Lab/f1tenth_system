<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1tenth_stack</name>
  <version>0.0.1</version>
  <description>Onboard drivers for vesc and sensors for F1TENTH vehicles.</description>
  <maintainer email="billyzheng.bz@gmail.com">Hongrui Zheng</maintainer>
  <license>MIT</license>

  <depend>ackermann_msgs</depend>
  <depend>urg_node</depend>
  <depend>joy</depend>
  <depend>joy_teleop</depend>
  <depend>rosbridge_server</depend>
  <depend>vesc</depend>
  <depend>std_msgs</depend>
  <depend>robot_localization</depend>
  <!-- Optional: known-map localization via fusion.launch.py localization_mode:=amcl
       (nav2_amcl + nav2_map_server), or map building via mapping.launch.py (slam_toolbox).
       The default lidar-odom flow does not need these. Already a dep of kw_f110_drive,
       listed here for completeness. -->
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
